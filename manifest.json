{
  "manifest_version": 3,
  "name": "Footprint - Local Privacy Score Analyzer",
  "version": "1.1",
  "description": "Analyzes local history and cookies to generate a local privacy score.",
  "permissions": [
    "history",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}